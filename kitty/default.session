
new_tab
layout splits:split_axis=horizontal
enabled_layouts splits:split_axis=horizontal
set_layout_state {"pairs": {"one": 1}, "opts": {"split_axis": "horizontal", "equalize_on_window_close": "n"}, "class": "Splits", "all_windows": {"active_group_idx": 0, "active_group_history": [1], "window_groups": [{"id": 1, "window_ids": [1, 3]}]}}
cd ../../dotfiles/personal/scripts

launch 'kitty-unserialize-data={"id": 1}' /usr/bin/zsh
focus

focus_tab 0