;;; -*- lexical-binding: t -*-
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(blink-cursor-mode nil)
 '(bookmark-default-file "~/.local/state/emacs/bookmarks.eld")
 '(column-number-mode t)
 '(cursor-in-non-selected-windows 'hollow)
 '(cursor-type 'box)
 '(display-line-numbers-type 'relative)
 '(eshell-directory-name "~/.local/state/emacs/eshell")
 '(evil-collection-setup-minibuffer t)
 '(evil-undo-system 'undo-tree)
 '(fringe-mode 13 nil (fringe))
 '(global-display-line-numbers-mode t)
 '(global-eldoc-mode nil)
 '(inhibit-startup-screen t)
 '(package-selected-packages
   '(## apheleia cape cond-let corfu dash diminish doom-themes evil
	evil-collection evil-matchit evil-surround flycheck general
	goto-chg llama magit magit-section marginalia orderless
	org-evil queue reformatter treesit treesit-auto undo-tree
	unimpaired vertico vterm wgrep with-editor zig-mode))
 '(package-user-dir "~/.local/share/emacs/elpa")
 '(project-buffers-viewer 'project-list-buffers-ibuffer)
 '(project-list-file "~/.local/state/emacs/projects.eld")
 '(transient-history-file "~/.local/state/emacs/transient/history.el")
 '(treesit-extra-load-path '("~/.local/state/treesitter"))
 '(truncate-lines t)
 '(warning-suppress-types '((use-package)))
 '(xref-search-program 'ripgrep))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
